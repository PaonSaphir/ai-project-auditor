{
  "name": "ai-project-auditor",
  "displayName": "AI Project Auditor",
  "description": "Audita tu proyecto y genera contexto listo para asistentes de IA.",
  "version": "1.0.0",
  "publisher": "paonsaphir",
  "license": "MIT",
  "engines": {
    "vscode": "^1.146.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "ai",
    "audit",
    "context",
    "llm",
    "prompt",
    "typescript",
    "productivity"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/PaonSaphir/ai-project-auditor.git"
  },
  "bugs": {
    "url": "https://github.com/PaonSaphir/ai-project-auditor/issues"
  },
  "homepage": "https://github.com/PaonSaphir/ai-project-auditor#readme",
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiProjectAuditor.scan",
        "title": "Auditar Proyecto (Escanear archivos)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.146.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
